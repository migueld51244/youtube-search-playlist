{
  "manifest_version": 3,
  "name": "YouTube Playlist Searcher",
  "version": "1.0",
  "description": "Be able to use a search bar inside your YT playlists!",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-search-playlist@migueld51244",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/main-logo-32.png"
  },
  "icons": {
    "16": "assets/main-logo-16.png",
    "32": "assets/main-logo-32.png",
    "48": "assets/main-logo-48.png",
    "128": "assets/main-logo-128.png"
  }
}
