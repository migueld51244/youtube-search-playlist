{
  "manifest_version": 3,
  "name": "YouTube Playlist Searcher",
  "version": "0.1",
  "description": "Be able to use a search bar inside your YT playlists!",
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "assets/main-logo.png"
  },
  "icons": {
    "16": "assets/main-logo.png",
    "32": "assets/main-logo.png",
    "48": "assets/main-logo.png",
    "128": "assets/main-logo.png"
  }
}
